# ACME Salary Management System - Backend Environment Config
DEBUG=True
SECRET_KEY=django-insecure-acme-prod-ready-secret-key-replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# Seeding & Pagination Settings
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
